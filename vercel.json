{
  "rewrites": [
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/help",
      "destination": "/:lang/help.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/changelog",
      "destination": "/:lang/changelog.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/blog",
      "destination": "/:lang/blog.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/blog/:slug",
      "destination": "/:lang/blog/:slug.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/guides/:slug",
      "destination": "/:lang/guides/:slug.html"
    },
    {
      "source": "/prop-firms",
      "destination": "/prop-firms.html"
    },
    {
      "source": "/prop-firms/:slug",
      "destination": "/prop-firms/:slug.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/prop-firms",
      "destination": "/:lang/prop-firms.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/prop-firms/:slug",
      "destination": "/:lang/prop-firms/:slug.html"
    },
    {
      "source": "/brokers",
      "destination": "/brokers.html"
    },
    {
      "source": "/brokers/:slug",
      "destination": "/brokers/:slug.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/brokers",
      "destination": "/:lang/brokers.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/brokers/:slug",
      "destination": "/:lang/brokers/:slug.html"
    },
    {
      "source": "/journal",
      "destination": "/index.html"
    },
    {
      "source": "/journal/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Reporting-Endpoints",
          "value": "csp=\"/api/emails?csp=1\""
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' https://clerk.simpletradejournal.io https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://clerk.simpletradejournal.io https://obaqhbfaeejepocsdgiv.supabase.co wss://obaqhbfaeejepocsdgiv.supabase.co; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; report-uri /api/emails?csp=1; report-to csp"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/emails",
      "schedule": "0 9 * * *"
    }
  ]
}
