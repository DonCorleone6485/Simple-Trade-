{
  "rewrites": [
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/help",
      "destination": "/:lang/help.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/changelog",
      "destination": "/:lang/changelog.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/blog",
      "destination": "/:lang/blog.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/blog/:slug",
      "destination": "/:lang/blog/:slug.html"
    },
    {
      "source": "/:lang(tr|fa|ar|ru|es|pt|de|fr)/guides/:slug",
      "destination": "/:lang/guides/:slug.html"
    },
    {
      "source": "/journal",
      "destination": "/index.html"
    },
    {
      "source": "/journal/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/emails",
      "schedule": "0 9 * * *"
    }
  ]
}
